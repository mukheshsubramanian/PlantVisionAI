# ============================================================================
# PlantVision AI - Environment Variable Configuration
# ============================================================================

# --- SERVER & DEPLOYMENT CONFIGURATION ---
HOST=0.0.0.0
PORT=8000
RELOAD=false
NO_BROWSER=true

# --- EMAIL NOTIFICATIONS & OTP AUTHENTICATION (SMTP) ---
# To send real 6-digit OTP verification codes via Gmail:
# 1. Enable 2-Step Verification on your Google Account: https://myaccount.google.com/security
# 2. Generate a 16-character App Password under "App passwords" for "PlantVision"
# 3. Paste the credentials below:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_FROM="PlantVision AI <your-email@gmail.com>"

# --- SMS NOTIFICATIONS & OTP (TWILIO - OPTIONAL) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
