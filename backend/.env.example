# ============================================================================
# PlantVision AI - Real Email & SMS Notification Configuration (.env)
# ============================================================================
# To send real 6-digit OTP passcodes directly to your Gmail inbox,
# configure your Google App Password below:
# 
# How to get a Gmail App Password in 30 seconds:
# 1. Go to your Google Account -> Security (https://myaccount.google.com/security)
# 2. Enable 2-Step Verification if not already enabled.
# 3. Search for "App passwords" -> Create an app named "PlantVision".
# 4. Copy the generated 16-character password into SMTP_PASSWORD below.
# ============================================================================

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional SMS Gateway (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
